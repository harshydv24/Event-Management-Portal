# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from: https://console.firebase.google.com > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting Configuration (all optional — sensible defaults are used)
# ──────────────────────────────────────────────────────────────────────────────

# Auth tier (login, signup, password reset) — strictest
VITE_RL_AUTH_MAX_ATTEMPTS=5               # Max attempts per 15-min window
VITE_RL_AUTH_WINDOW_MS=900000             # Window duration (15 min)
VITE_RL_AUTH_BACKOFF_BASE_MS=2000         # Initial backoff delay (2 sec)
VITE_RL_AUTH_BACKOFF_MAX_MS=300000        # Max backoff cap (5 min)
VITE_RL_AUTH_BACKOFF_MULTIPLIER=2         # Backoff multiplier (delay doubles)

# Public tier (read-only endpoints) — moderate
VITE_RL_PUBLIC_MAX_ATTEMPTS=30            # Max requests per 1-min window
VITE_RL_PUBLIC_WINDOW_MS=60000            # Window duration (1 min)

# Authenticated tier (user write actions) — loosest
VITE_RL_AUTHENTICATED_MAX_ATTEMPTS=60     # Max requests per 1-min window
VITE_RL_AUTHENTICATED_WINDOW_MS=60000     # Window duration (1 min)

# Resend verification email — special case
VITE_RL_RESEND_EMAIL_MAX_ATTEMPTS=3       # Max resends per 15-min window
VITE_RL_RESEND_EMAIL_WINDOW_MS=900000     # Window duration (15 min)

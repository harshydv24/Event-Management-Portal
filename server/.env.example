# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas recommended for production)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/event-nexus

# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Firebase Admin SDK ──────────────────────────────────────────────────
# Option A (Local): Path to service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B (Cloud/Render): Paste the ENTIRE JSON content as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","..."}

# ─── CORS ─────────────────────────────────────────────────────────────────
# Your frontend's production URL (e.g., https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# ─── File Uploads ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Cloudinary (Optional — falls back to local disk if not set) ─────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=event-nexus
